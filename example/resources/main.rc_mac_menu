// PulpEmbedIPlug SWELL menu resource (macOS standalone app).
//
// Derived from iPlug2's Examples/IPlugEffect template (WDL license; see
// NOTICE.md). Trimmed to PulpEmbedIPlug's menus: the IGraphics-only Debug
// items were dropped because this example builds UI NONE (the editor IS the
// embedded Pulp native view — no IGraphics surface to inspect).
SWELL_DEFINE_MENU_RESOURCE_BEGIN(IDR_MENU1)
    POPUP "&File"
    BEGIN
        MENUITEM "&Preferences...\tCtrl+,",     ID_PREFERENCES
        MENUITEM "&Quit",                       ID_QUIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About",                      ID_ABOUT
    END
SWELL_DEFINE_MENU_RESOURCE_END(IDR_MENU1)



//EOF
